<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineMaximo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.8" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/message_card_external_margin"
        android:layout_marginTop="@dimen/message_card_external_margin"
        android:layout_marginRight="@dimen/message_card_external_margin"
        android:layout_marginBottom="@dimen/message_card_external_margin"
        android:orientation="vertical"
        app:cardBackgroundColor="#E9DDC0"
        app:cardCornerRadius="@dimen/message_card_corner_radius"

        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineMaximo"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lytMessageWrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtSenderUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/message_card_margin"
                android:layout_marginTop="@dimen/message_card_margin"
                android:layout_marginEnd="@dimen/message_card_margin"
                android:text="a"
                android:textColor="@color/message_card_sender_user_color"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtMessageContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/message_card_margin"
                android:layout_marginTop="@dimen/message_card_text_separation"
                android:layout_marginEnd="@dimen/message_card_margin"
                android:text="prueba"
                android:textSize="@dimen/message_card_message_content_text_size"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtSenderUser" />

            <TextView
                android:id="@+id/txtTimeStamp"
                android:layout_width="wrap_content"
                android:layout_height="11dp"
                android:layout_marginStart="@dimen/message_card_margin"
                android:layout_marginTop="@dimen/message_card_text_separation"
                android:layout_marginEnd="@dimen/message_card_margin"
                android:layout_marginBottom="@dimen/message_card_margin"
                android:text="txtTimeStamp"
                android:textSize="@dimen/message_card_time_stamp_text_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtMessageContent" />;
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>