<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ProyectoAndroid" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/btn_dark</item>
        <item name="colorPrimaryVariant">@color/txt_title</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/txt_welcome</item>
        <item name="colorSecondaryVariant">@color/txt_welcome</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.ProyectoAndroid.Login" parent="Theme.ProyectoAndroid">
        <item name="android:windowBackground">@drawable/bg_login_gradient</item>
    </style>
</resources>